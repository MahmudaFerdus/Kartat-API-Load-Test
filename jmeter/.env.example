# ==============================================================================
# Kartat API Load Test Configuration (.env)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Do NOT commit .env (it is gitignored).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credentials (REQUIRED)
# ------------------------------------------------------------------------------
CLIENT_ID=YOUR_CLIENT_ID
CLIENT_SECRET=YOUR_CLIENT_SECRET
PASSWORD=YOUR_PASSWORD

# ------------------------------------------------------------------------------
# 2. Target API Endpoint
# ------------------------------------------------------------------------------
BASE_URL=https://dev-apigw.cardselling.cash

# ------------------------------------------------------------------------------
# 3. Load Profile Configuration
# ------------------------------------------------------------------------------
# Profile A: Sustained 6 TPS Target Test (RECOMMENDED to achieve 6 TPS)
#   - Paced arrival rate at exactly 6 purchases/second.
#   - Little's Law: 6 TPS * ~2.5s server latency = 15 threads needed; 35 gives buffer.
#   - RAMP_TIME=10 ensures 6 TPS is achieved within the first few seconds.
#
# Profile B: Bottleneck / Capacity Ramp Test (to find breaking point)
#   - LOAD_SHAPE=open, NUM_THREADS=60, RAMP_TIME=300, ENABLE_PURCHASE_THROTTLE=false
# ------------------------------------------------------------------------------
LOAD_SHAPE=open
NUM_THREADS=35
RAMP_TIME=10
DURATION=300
THREAD_GROUP_DURATION=300
DRAIN_SECONDS=0
TOTAL_PURCHASES=0
ENABLE_PURCHASE_THROTTLE=true
TARGET_PURCHASE_TPS=6

# ------------------------------------------------------------------------------
# 4. Purchase Parameters
# ------------------------------------------------------------------------------
QTY=1
SIP=0662981885
RANDOM_DEALER_NUMBER=true
DEALER_NUMBER=ABC123
ASIACELL_MSISDN=9647706055187
CONNECT_TIMEOUT_MS=3000
RESPONSE_TIMEOUT_MS=50000

# ------------------------------------------------------------------------------
# 5. Data & File Paths
# ------------------------------------------------------------------------------
RESELLER_CSV=data/reseller.csv
PRODUCTS_CSV=data/products.csv
