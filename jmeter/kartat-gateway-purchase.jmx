        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Load .env and secrets" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename" />
          <stringProp name="parameters" />
          <stringProp name="script">import java.net.URI
import org.apache.jmeter.services.FileServer

def baseDir = new File(FileServer.getFileServer().getBaseDir() ?: ".")

def envCandidates = [
    new File(baseDir, ".env"),
    new File(baseDir.getParentFile(), ".env"),
    new File(baseDir, "secrets.properties"),
    new File(baseDir.getParentFile(), "secrets.properties")
]

def customFile = props.get("secretsFile") ?: vars.get("secretsFile")
if (customFile != null &amp;&amp; customFile.toString().trim()) {
    def f = new File(customFile.toString().trim())
    if (!f.isAbsolute()) {
        f = new File(baseDir, customFile.toString().trim())
    }
    envCandidates.add(0, f)
}

def keyAliases = [
    "BASE_URL": "base_url",
    "CLIENT_ID": "client_id",
    "CLIENT_SECRET": "client_secret",
    "PASSWORD": "password",
    "NUM_THREADS": "num_threads",
    "RAMP_TIME": "ramp_time",
    "DURATION": "duration",
    "DRAIN_SECONDS": "drainSeconds",
    "THREAD_GROUP_DURATION": "threadGroupDuration",
    "LOAD_SHAPE": "loadShape",
    "TOTAL_PURCHASES": "totalPurchases",
    "QTY": "qty",
    "SIP": "sip",
    "DEALER_NUMBER": "dealer_number",
    "ASIACELL_MSISDN": "asiacellMsisdn",
    "CONNECT_TIMEOUT_MS": "connectTimeoutMs",
    "RESPONSE_TIMEOUT_MS": "responseTimeoutMs",
    "RESELLER_CSV": "resellerCsv",
    "PRODUCTS_CSV": "productsCsv",
    "ENABLE_PURCHASE_THROTTLE": "enablePurchaseThrottle",
    "TARGET_PURCHASE_TPS": "targetPurchaseTps",
    "RANDOM_DEALER_NUMBER": "randomDealerNumber"
]

int filled = 0
def loadedFiles = []
envCandidates.unique().each { f -&gt;
    if (f != null &amp;&amp; f.isFile()) {
        loadedFiles.add(f.getName())
        f.eachLine("UTF-8") { line -&gt;
            def raw = line.replace("﻿", "").trim()
            if (!raw || raw.startsWith("#") || raw.startsWith("!")) {
                return
            }
            if (raw.startsWith("export ")) {
                raw = raw.substring(7).trim()
            }
            def eq = raw.indexOf("=")
            if (eq &lt; 1) {
                return
            }
            def key = raw.substring(0, eq).trim()
            def value = raw.substring(eq + 1).trim()
            if ((value.startsWith(""") &amp;&amp; value.endsWith(""")) || (value.startsWith("'") &amp;&amp; value.endsWith("'"))) {
                if (value.length() &gt;= 2) {
                    value = value.substring(1, value.length() - 1)
                }
            }
            if (key) {
                def targetKeys = [key]
                if (keyAliases.containsKey(key)) {
                    targetKeys.add(keyAliases[key])
                }
                targetKeys.add(key.toLowerCase())
                targetKeys.unique().each { tKey -&gt;
                    def existing = props.get(tKey)
                    if (existing == null || existing.toString().trim().isEmpty()) {
                        props.put(tKey, value)
                        filled++
                    }
                }
            }
        }
    }
}
if (!loadedFiles.isEmpty()) {
    log.info("Configuration loaded from: " + loadedFiles.join(", ") + ". Filled " + filled + " properties.")
} else {
    log.warn("No .env or secrets.properties file found.")
}

def missing = ["client_id", "client_secret", "password"].findAll { key -&gt;
    def value = props.get(key) ?: props.get(key.toUpperCase())
    value == null || value.toString().trim().isEmpty()
}
missing.each { key -&gt;
    log.error("Missing " + key + ". Define it in .env or secrets.properties or pass -J" + key)
}

def rawBase = props.get("base_url") ?: props.get("BASE_URL")
if (rawBase == null || rawBase.toString().trim().isEmpty()) {
    rawBase = vars.get("base_url")
}
if (rawBase == null || rawBase.toString().trim().isEmpty()) {
    rawBase = "https://dev-apigw.cardselling.cash"
}
def baseUrl = rawBase.toString().trim()
while (baseUrl.endsWith("/")) {
    baseUrl = baseUrl.substring(0, baseUrl.length() - 1)
}
def uri = new URI(baseUrl)
if (!uri.scheme || !uri.host) {
    throw new IllegalStateException("base_url must be an absolute http or https URL")
}
props.put("base_url", baseUrl)
props.put("kartat_scheme", uri.scheme)
props.put("kartat_host", uri.host)
props.put("kartat_port", uri.port &gt; 0 ? String.valueOf(uri.port) : "")
log.info("Gateway host " + uri.scheme + "://" + uri.host + (uri.port &gt; 0 ? ":" + uri.port : ""))

if (props.get("threadGroupDuration") == null || props.get("threadGroupDuration").toString().trim().isEmpty()) {
    def shape = props.get("loadShape") ?: props.get("LOAD_SHAPE")
    if (shape == null || shape.toString().trim().isEmpty()) {
        shape = vars.get("loadShape") ?: "fixed"
    }
    def duration = props.get("duration") ?: props.get("DURATION")
    if (duration == null || duration.toString().trim().isEmpty()) {
        duration = vars.get("duration") ?: "60"
    }
    def drain = props.get("drainSeconds") ?: props.get("DRAIN_SECONDS")
    if (drain == null || drain.toString().trim().isEmpty()) {
        drain = vars.get("drainSeconds") ?: "30"
    }
    int window = Integer.parseInt(duration.toString().trim())
    int extra = Integer.parseInt(drain.toString().trim())
    int scheduled = shape.toString().equalsIgnoreCase("open") ? window : window + extra
    props.put("threadGroupDuration", String.valueOf(scheduled))
    log.info("threadGroupDuration=" + scheduled + " for loadShape=" + shape)
}

if (!missing.isEmpty()) {
    SampleResult.setStopTestNow(true)
    try {
        org.apache.jmeter.threads.JMeterContextService.getContext().getEngine().stopTest(true)
    } catch (Throwable ignored) {}
}

SampleResult.setResponseCode(missing.isEmpty() ? "200" : "500")
SampleResult.setSuccessful(missing.isEmpty())
SampleResult.setResponseMessage(missing.isEmpty() ? "configuration ready" : ("missing " + missing.join(",")))
SampleResult.setResponseData("credential values are not stored in this sample", "UTF-8")</stringProp>
