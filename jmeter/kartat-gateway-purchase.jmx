        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Schedule purchase" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename" />
          <stringProp name="parameters" />
          <stringProp name="script">import org.apache.jmeter.services.FileServer

def propOrVar = { String key, String fallback -&gt;
    def fromProp = props.get(key)
    if (fromProp != null &amp;&amp; fromProp.toString().trim()) {
        return fromProp.toString().trim()
    }
    def fromVar = vars.get(key)
    if (fromVar != null &amp;&amp; fromVar.toString().trim()) {
        return fromVar.toString().trim()
    }
    return fallback
}

def shape = propOrVar("loadShape", "fixed").toLowerCase()
if (!"open".equals(shape)) {
    shape = "fixed"
}
def runId = (props.get("TESTSTART.MS") ?: "0").toString()
vars.put("skipPurchase", "true")

int total
def totalProp = props.get("totalPurchases")
if (totalProp != null &amp;&amp; totalProp.toString().trim()) {
    total = Integer.parseInt(totalProp.toString().trim())
} else if ("fixed".equals(shape)) {
    def fromVar = vars.get("totalPurchases")
    total = (fromVar != null &amp;&amp; fromVar.toString().trim()) ? Integer.parseInt(fromVar.toString().trim()) : 180
} else {
    total = 0
}
long duration = Long.parseLong(propOrVar("duration", "fixed".equals(shape) ? "60" : "300"))
if (duration &lt; 1L) {
    duration = 1L
}

class KartatFixedSchedule {
    static final Object LOCK = new Object()
    static String runId = ""
    static long startMs = 0L
    static int issued = 0
}
class KartatOpenCap {
    static final Object LOCK = new Object()
    static String runId = ""
    static int issued = 0
}
class KartatProductCatalog {
    static final Object LOCK = new Object()
    static String runId = ""
    static String loadedFrom = ""
    static List rows = []
    static int next = 0
}
class KartatPurchaseThrottle {
    static final Object LOCK = new Object()
    static String runId = ""
    static long nextAllowedMs = 0L
}

def finishSchedule = {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode("200")
    SampleResult.setResponseMessage("purchase schedule complete")
    SampleResult.setIgnore()
    SampleResult.setStopThread(true)
}

try {
    if ("fixed".equals(shape)) {
        if (total &lt; 1) {
            throw new IllegalStateException("fixed load requires totalPurchases &gt;= 1")
        }
        int slot = 0
        long target = 0L
        synchronized (KartatFixedSchedule.LOCK) {
            if (!runId.equals(KartatFixedSchedule.runId)) {
                KartatFixedSchedule.runId = runId
                KartatFixedSchedule.startMs = 0L
                KartatFixedSchedule.issued = 0
            }
            if (KartatFixedSchedule.startMs == 0L) {
                KartatFixedSchedule.startMs = System.currentTimeMillis()
            }
            KartatFixedSchedule.issued++
            slot = KartatFixedSchedule.issued
            if (slot &lt;= total) {
                double intervalMs = (duration * 1000.0d) / total
                target = KartatFixedSchedule.startMs + Math.round((slot - 1) * intervalMs)
            }
        }
        if (slot &gt; total) {
            finishSchedule()
            return null
        }
        long waitMs = target - System.currentTimeMillis()
        if (waitMs &gt; 0L) {
            Thread.sleep(waitMs)
        } else {
            double intervalMs = (duration * 1000.0d) / total
            if (Math.abs(waitMs) &gt; intervalMs * 2) {
                log.warn("Purchase schedule lagging behind target by " + Math.abs(waitMs) + "ms at slot " + slot + ". Consider increasing num_threads or check server latency.")
            }
        }
        vars.put("purchaseSlot", String.valueOf(slot))
    } else {
        if (total &gt; 0) {
            int slot = 0
            synchronized (KartatOpenCap.LOCK) {
                if (!runId.equals(KartatOpenCap.runId)) {
                    KartatOpenCap.runId = runId
                    KartatOpenCap.issued = 0
                }
                KartatOpenCap.issued++
                slot = KartatOpenCap.issued
            }
            if (slot &gt; total) {
                finishSchedule()
                return null
            }
            vars.put("purchaseSlot", String.valueOf(slot))
        }
        if ("true".equalsIgnoreCase(propOrVar("enablePurchaseThrottle", "false"))) {
            double tps = Double.parseDouble(propOrVar("targetPurchaseTps", "3"))
            if (tps &gt; 0d) {
                long waitMs = 0L
                synchronized (KartatPurchaseThrottle.LOCK) {
                    if (!runId.equals(KartatPurchaseThrottle.runId)) {
                        KartatPurchaseThrottle.runId = runId
                        KartatPurchaseThrottle.nextAllowedMs = 0L
                    }
                    long intervalMs = Math.max(1L, (long) (1000.0d / tps))
                    long now = System.currentTimeMillis()
                    long scheduled = KartatPurchaseThrottle.nextAllowedMs
                    if (scheduled == 0L || now - scheduled &gt; intervalMs * 5L) {
                        scheduled = now
                    }
                    if (now &lt; scheduled) {
                        waitMs = scheduled - now
                        KartatPurchaseThrottle.nextAllowedMs = scheduled + intervalMs
                    } else {
                        KartatPurchaseThrottle.nextAllowedMs = now + intervalMs
                    }
                }
                if (waitMs &gt; 0L) {
                    Thread.sleep(waitMs)
                }
            }
        }
    }

    if (!runId.equals(props.get("kartatScheduleLoggedRun"))) {
        props.put("kartatScheduleLoggedRun", runId)
        log.info("Purchase schedule shape=" + shape + " totalPurchases=" + total + " durationSec=" + duration)
    }

    def csvProp = propOrVar("productsCsv", "data/products.csv")
    def csvFile = new File(csvProp)
    if (!csvFile.isAbsolute()) {
        csvFile = new File(FileServer.getFileServer().getBaseDir() ?: ".", csvProp)
    }
    List rows
    synchronized (KartatProductCatalog.LOCK) {
        if (!runId.equals(KartatProductCatalog.runId) || !csvFile.getAbsolutePath().equals(KartatProductCatalog.loadedFrom)) {
            def parsed = []
            if (csvFile.isFile()) {
                def header = null
                csvFile.eachLine("UTF-8") { line -&gt;
                    def raw = line.replace("\uFEFF", "").trim()
                    if (!raw || raw.startsWith("#")) {
                        return
                    }
                    def cols = raw.split(",", -1).collect { it.trim() }
                    if (header == null) {
                        header = cols
                        return
                    }
                    def map = [:]
                    header.eachWithIndex { column, index -&gt;
                        map[column] = index &lt; cols.size() ? cols[index] : ""
                    }
                    def productId = (map.product_id ?: map.operator_id ?: "").toString()
                    def bundleId = (map.bundle_id ?: "").toString()
                    if (productId ==~ /[0-9]+/ &amp;&amp; bundleId ==~ /[0-9]+/) {
                        map.product_id = productId
                        parsed.add(map)
                    } else {
                        log.warn("Skipping products.csv row because product_id and bundle_id must both be numeric")
                    }
                }
            }
            KartatProductCatalog.rows = parsed
            KartatProductCatalog.next = 0
            KartatProductCatalog.runId = runId
            KartatProductCatalog.loadedFrom = csvFile.getAbsolutePath()
            log.info("Loaded " + parsed.size() + " product rows from " + csvFile.getName())
        }
        rows = KartatProductCatalog.rows
        if (rows != null &amp;&amp; !rows.isEmpty()) {
            def row = rows[KartatProductCatalog.next % rows.size()]
            KartatProductCatalog.next++
            def msisdn = (row.msisdn ?: "").toString().trim()
            if (!msisdn) {
                msisdn = propOrVar("asiacellMsisdn", "9647706055187")
            }
            vars.put("operator_id", (row.product_id ?: row.operator_id).toString())
            vars.put("bundle_id", row.bundle_id.toString())
            def rowName = (row.name ?: row.bundle_name ?: row.product_name ?: "").toString()
            vars.put("product_name", (row.product_name ?: rowName).toString())
            vars.put("bundle_name", rowName)
            vars.put("msisdn", msisdn)

            def rowDealer = (row.dealer_number ?: "").toString().trim()
            if (rowDealer) {
                vars.put("dealer_number", rowDealer)
            } else {
                def randomDealerSetting = propOrVar("randomDealerNumber", "true")
                def configuredDealer = propOrVar("dealer_number", "")
                if (!configuredDealer || "random".equalsIgnoreCase(configuredDealer) || "true".equalsIgnoreCase(randomDealerSetting)) {
                    def chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
                    def digits = "0123456789"
                    def r = java.util.concurrent.ThreadLocalRandom.current()
                    def prefix = (0..2).collect { chars.charAt(r.nextInt(chars.length())) }.join()
                    def num = (0..2).collect { digits.charAt(r.nextInt(digits.length())) }.join()
                    vars.put("dealer_number", prefix + num)
                } else {
                    vars.put("dealer_number", configuredDealer)
                }
            }
        }
    }
    if (rows == null || rows.isEmpty()) {
        throw new IllegalStateException("No product rows in " + csvFile.getAbsolutePath())
    }

    vars.put("skipPurchase", "false")
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode("200")
    SampleResult.setResponseMessage("scheduled")
    SampleResult.setIgnore()
} catch (InterruptedException interrupted) {
    Thread.currentThread().interrupt()
    vars.put("skipPurchase", "true")
    SampleResult.setIgnore()
    SampleResult.setStopThread(true)
} catch (Exception error) {
    vars.put("skipPurchase", "true")
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode("500")
    SampleResult.setResponseMessage(error.getClass().getSimpleName() + ": " + error.getMessage())
    SampleResult.setStopThread(true)
}
return null</stringProp>
