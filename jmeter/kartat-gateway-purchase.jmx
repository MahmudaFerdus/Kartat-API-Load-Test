          <boolProp name="recycle">true</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
          <boolProp name="stopThread">false</boolProp>
          <stringProp name="variableNames">username</stringProp>
        </CSVDataSet>
        <hashTree/>
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Log in once" enabled="true"/>
        <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="oauth/token" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="grant_type" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">grant_type</stringProp>
                <stringProp name="Argument.value">password</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="client_id" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">client_id</stringProp>
                <stringProp name="Argument.value">${__P(client_id)}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="client_secret" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">client_secret</stringProp>
                <stringProp name="Argument.value">${__P(client_secret)}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="username" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">username</stringProp>
                <stringProp name="Argument.value">${username}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="password" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">password</stringProp>
                <stringProp name="Argument.value">${__P(password)}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="scope" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.name">scope</stringProp>
                <stringProp name="Argument.value">*</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(kartat_host,dev-apigw.cardselling.cash)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(kartat_port,)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(kartat_scheme,https)}</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/oauth/token</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">true</boolProp>
          <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          <stringProp name="HTTPSampler.connect_timeout">${connectTimeoutMs}</stringProp>
          <stringProp name="HTTPSampler.response_timeout">${responseTimeoutMs}</stringProp>
        </HTTPSamplerProxy>
          <hashTree>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract access_token" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">access_token</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.access_token</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Require access_token" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def token = vars.get("access_token")
if (token == null || token.trim().isEmpty() || "NOT_FOUND".equals(token)) {
    prev.setSuccessful(false)
    prev.setResponseMessage("oauth/token response did not include access_token")
    prev.setStopThread(true)
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If access token" enabled="true">
          <stringProp name="IfController.condition">${__groovy(def t = vars.get("access_token"); t != null &amp;&amp; !"NOT_FOUND".equals(t) &amp;&amp; t.trim().length() &gt; 0)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Schedule purchase" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import org.apache.jmeter.services.FileServer

def propOrVar = { String key, String fallback -&gt;
    def fromProp = props.get(key)
    if (fromProp != null &amp;&amp; fromProp.toString().trim()) {
        return fromProp.toString().trim()
    }
    def fromVar = vars.get(key)
    if (fromVar != null &amp;&amp; fromVar.toString().trim()) {
        return fromVar.toString().trim()
    }
    return fallback
}

def shape = propOrVar("loadShape", "fixed").toLowerCase()
if (!"open".equals(shape)) {
    shape = "fixed"
}
def runId = (props.get("TESTSTART.MS") ?: "0").toString()
vars.put("skipPurchase", "true")

int total
def totalProp = props.get("totalPurchases")
if (totalProp != null &amp;&amp; totalProp.toString().trim()) {
    total = Integer.parseInt(totalProp.toString().trim())
} else if ("fixed".equals(shape)) {
    def fromVar = vars.get("totalPurchases")
    total = (fromVar != null &amp;&amp; fromVar.toString().trim()) ? Integer.parseInt(fromVar.toString().trim()) : 180
} else {
    total = 0
}
long duration = Long.parseLong(propOrVar("duration", "fixed".equals(shape) ? "60" : "300"))
if (duration &lt; 1L) {
    duration = 1L
}

class KartatFixedSchedule {
    static final Object LOCK = new Object()
    static String runId = ""
    static long startMs = 0L
    static int issued = 0
}
class KartatOpenCap {
    static final Object LOCK = new Object()
    static String runId = ""
    static int issued = 0
}
class KartatProductCatalog {
    static final Object LOCK = new Object()
    static String runId = ""
    static String loadedFrom = ""
    static List rows = []
    static int next = 0
}
class KartatPurchaseThrottle {
    static final Object LOCK = new Object()
    static String runId = ""
    static long nextAllowedMs = 0L
}

def finishSchedule = {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode("200")
    SampleResult.setResponseMessage("purchase schedule complete")
    SampleResult.setIgnore()
    SampleResult.setStopThread(true)
}

try {
    if ("fixed".equals(shape)) {
        if (total &lt; 1) {
            throw new IllegalStateException("fixed load requires totalPurchases &gt;= 1")
        }
        int slot = 0
        long target = 0L
        synchronized (KartatFixedSchedule.LOCK) {
            if (!runId.equals(KartatFixedSchedule.runId)) {
                KartatFixedSchedule.runId = runId
                KartatFixedSchedule.startMs = 0L
                KartatFixedSchedule.issued = 0
            }
            if (KartatFixedSchedule.startMs == 0L) {
                KartatFixedSchedule.startMs = System.currentTimeMillis()
            }
            KartatFixedSchedule.issued++
            slot = KartatFixedSchedule.issued
            if (slot &lt;= total) {
                double intervalMs = (duration * 1000.0d) / total
                target = KartatFixedSchedule.startMs + Math.round((slot - 1) * intervalMs)
            }
        }
        if (slot &gt; total) {
            finishSchedule()
            return null
        }
        long waitMs = target - System.currentTimeMillis()
        if (waitMs &gt; 0L) {
            Thread.sleep(waitMs)
        }
        vars.put("purchaseSlot", String.valueOf(slot))
    } else {
        if (total &gt; 0) {
            int slot = 0
            synchronized (KartatOpenCap.LOCK) {
                if (!runId.equals(KartatOpenCap.runId)) {
                    KartatOpenCap.runId = runId
                    KartatOpenCap.issued = 0
                }
                KartatOpenCap.issued++
                slot = KartatOpenCap.issued
            }
            if (slot &gt; total) {
                finishSchedule()
                return null
            }
            vars.put("purchaseSlot", String.valueOf(slot))
        }
        if ("true".equalsIgnoreCase(propOrVar("enablePurchaseThrottle", "false"))) {
            double tps = Double.parseDouble(propOrVar("targetPurchaseTps", "3"))
            if (tps &gt; 0d) {
                long waitMs = 0L
                synchronized (KartatPurchaseThrottle.LOCK) {
                    if (!runId.equals(KartatPurchaseThrottle.runId)) {
                        KartatPurchaseThrottle.runId = runId
                        KartatPurchaseThrottle.nextAllowedMs = 0L
                    }
                    long intervalMs = Math.max(1L, (long) (1000.0d / tps))
                    long now = System.currentTimeMillis()
                    long scheduled = KartatPurchaseThrottle.nextAllowedMs
                    if (scheduled == 0L || now - scheduled &gt; intervalMs * 5L) {
                        scheduled = now
                    }
                    if (now &lt; scheduled) {
                        waitMs = scheduled - now
                        KartatPurchaseThrottle.nextAllowedMs = scheduled + intervalMs
                    } else {
                        KartatPurchaseThrottle.nextAllowedMs = now + intervalMs
                    }
                }
                if (waitMs &gt; 0L) {
                    Thread.sleep(waitMs)
                }
            }
        }
    }

    if (!runId.equals(props.get("kartatScheduleLoggedRun"))) {
        props.put("kartatScheduleLoggedRun", runId)
        log.info("Purchase schedule shape=" + shape + " totalPurchases=" + total + " durationSec=" + duration)
    }

    def csvProp = propOrVar("productsCsv", "data/products.csv")
    def csvFile = new File(csvProp)
    if (!csvFile.isAbsolute()) {
        csvFile = new File(FileServer.getFileServer().getBaseDir() ?: ".", csvProp)
    }
    List rows
    synchronized (KartatProductCatalog.LOCK) {
        if (!runId.equals(KartatProductCatalog.runId) || !csvFile.getAbsolutePath().equals(KartatProductCatalog.loadedFrom)) {
            def parsed = []
            if (csvFile.isFile()) {
                def header = null
                csvFile.eachLine("UTF-8") { line -&gt;
                    def raw = line.replace("\uFEFF", "").trim()
                    if (!raw || raw.startsWith("#")) {
                        return
                    }
                    def cols = raw.split(",", -1).collect { it.trim() }
                    if (header == null) {
                        header = cols
                        return
                    }
                    def map = [:]
                    header.eachWithIndex { column, index -&gt;
                        map[column] = index &lt; cols.size() ? cols[index] : ""
                    }
                    def productId = (map.product_id ?: map.operator_id ?: "").toString()
                    def bundleId = (map.bundle_id ?: "").toString()
                    if (productId ==~ /[0-9]+/ &amp;&amp; bundleId ==~ /[0-9]+/) {
                        map.product_id = productId
                        parsed.add(map)
                    } else {
                        log.warn("Skipping products.csv row because product_id and bundle_id must both be numeric")
                    }
                }
            }
            KartatProductCatalog.rows = parsed
            KartatProductCatalog.next = 0
            KartatProductCatalog.runId = runId
            KartatProductCatalog.loadedFrom = csvFile.getAbsolutePath()
            log.info("Loaded " + parsed.size() + " product rows from " + csvFile.getName())
        }
        rows = KartatProductCatalog.rows
        if (rows != null &amp;&amp; !rows.isEmpty()) {
            def row = rows[KartatProductCatalog.next % rows.size()]
            KartatProductCatalog.next++
            def msisdn = (row.msisdn ?: "").toString().trim()
            if (!msisdn) {
                msisdn = propOrVar("asiacellMsisdn", "9647706055187")
            }
            vars.put("operator_id", (row.product_id ?: row.operator_id).toString())
            vars.put("bundle_id", row.bundle_id.toString())
            def rowName = (row.name ?: row.bundle_name ?: row.product_name ?: "").toString()
            vars.put("product_name", (row.product_name ?: rowName).toString())
            vars.put("bundle_name", rowName)
            vars.put("msisdn", msisdn)
        }
    }
    if (rows == null || rows.isEmpty()) {
        throw new IllegalStateException("No product rows in " + csvFile.getAbsolutePath())
    }

    vars.put("skipPurchase", "false")
    SampleResult.setSuccessful(true)
    SampleResult.setResponseCode("200")
    SampleResult.setResponseMessage("scheduled")
    SampleResult.setIgnore()
} catch (InterruptedException interrupted) {
    Thread.currentThread().interrupt()
    vars.put("skipPurchase", "true")
    SampleResult.setIgnore()
    SampleResult.setStopThread(true)
} catch (Exception error) {
    vars.put("skipPurchase", "true")
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode("500")
    SampleResult.setResponseMessage(error.getClass().getSimpleName() + ": " + error.getMessage())
    SampleResult.setStopThread(true)
}
return null</stringProp>
