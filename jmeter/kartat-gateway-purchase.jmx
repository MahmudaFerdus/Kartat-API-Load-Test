      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Read secrets.properties" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.net.URI
import org.apache.jmeter.services.FileServer

def baseDir = new File(FileServer.getFileServer().getBaseDir() ?: ".")
def secretsName = (props.get("secretsFile") ?: vars.get("secretsFile") ?: "secrets.properties").toString().trim()
if (!secretsName) {
    secretsName = "secrets.properties"
}
def secrets = new File(secretsName)
if (!secrets.isAbsolute()) {
    secrets = new File(baseDir, secretsName)
}

int filled = 0
if (secrets.isFile()) {
    secrets.eachLine("UTF-8") { line -&gt;
        def raw = line.replace("\uFEFF", "").trim()
        if (!raw || raw.startsWith("#") || raw.startsWith("!")) {
            return
        }
        def eq = raw.indexOf("=")
        if (eq &lt; 1) {
            return
        }
        def key = raw.substring(0, eq).trim()
        def value = raw.substring(eq + 1).trim()
        def existing = props.get(key)
        if (key &amp;&amp; (existing == null || existing.toString().trim().isEmpty())) {
            props.put(key, value)
            filled++
        }
    }
    log.info("Secrets file " + secrets.getName() + " filled " + filled + " empty properties. Existing -J and -q values were kept.")
} else {
    log.warn("Secrets file not found at " + secrets.getAbsolutePath())
}

def missing = ["client_id", "client_secret", "password"].findAll { key -&gt;
    def value = props.get(key)
    value == null || value.toString().trim().isEmpty()
}
missing.each { key -&gt;
    log.error("Missing " + key + ". Put it in secrets.properties or pass -J" + key + " without printing the value.")
}

def rawBase = props.get("base_url")
if (rawBase == null || rawBase.toString().trim().isEmpty()) {
    rawBase = vars.get("base_url")
}
if (rawBase == null || rawBase.toString().trim().isEmpty()) {
    rawBase = "https://dev-apigw.cardselling.cash"
}
def baseUrl = rawBase.toString().trim()
while (baseUrl.endsWith("/")) {
    baseUrl = baseUrl.substring(0, baseUrl.length() - 1)
}
def uri = new URI(baseUrl)
if (!uri.scheme || !uri.host) {
    throw new IllegalStateException("base_url must be an absolute http or https URL")
}
props.put("base_url", baseUrl)
props.put("kartat_scheme", uri.scheme)
props.put("kartat_host", uri.host)
props.put("kartat_port", uri.port &gt; 0 ? String.valueOf(uri.port) : "")
log.info("Gateway host " + uri.scheme + "://" + uri.host + (uri.port &gt; 0 ? ":" + uri.port : ""))

if (props.get("threadGroupDuration") == null || props.get("threadGroupDuration").toString().trim().isEmpty()) {
    def shape = props.get("loadShape")
    if (shape == null || shape.toString().trim().isEmpty()) {
        shape = vars.get("loadShape") ?: "fixed"
    }
    def duration = props.get("duration")
    if (duration == null || duration.toString().trim().isEmpty()) {
        duration = vars.get("duration") ?: "60"
    }
    def drain = props.get("drainSeconds")
    if (drain == null || drain.toString().trim().isEmpty()) {
        drain = vars.get("drainSeconds") ?: "30"
    }
    int window = Integer.parseInt(duration.toString().trim())
    int extra = Integer.parseInt(drain.toString().trim())
    int scheduled = shape.toString().equalsIgnoreCase("open") ? window : window + extra
    props.put("threadGroupDuration", String.valueOf(scheduled))
    log.info("threadGroupDuration=" + scheduled + " for loadShape=" + shape)
}

SampleResult.setResponseCode(missing.isEmpty() ? "200" : "500")
SampleResult.setSuccessful(missing.isEmpty())
SampleResult.setResponseMessage(missing.isEmpty() ? "secrets ready" : ("missing " + missing.join(",")))
SampleResult.setResponseData("credential values are not stored in this sample", "UTF-8")</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Purchase workers" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${num_threads}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${ramp_time}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(threadGroupDuration,90)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Reseller" enabled="true">
