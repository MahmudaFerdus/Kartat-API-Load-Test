          <stringProp name="script">vars.put("validateOk", "false")
try {
    def text = prev.getResponseDataAsString()
    if (text != null &amp;&amp; text.trim().startsWith("{")) {
        def body = new groovy.json.JsonSlurper().parseText(text)
        def status = body instanceof Map ? body.get("status") : null
        if (Boolean.TRUE.equals(status) || "true".equalsIgnoreCase(String.valueOf(status))) {
            vars.put("validateOk", "true")
        }
    }
} catch (Exception ignored) {
    vars.put("validateOk", "false")
}
if (!"true".equals(vars.get("validateOk"))) {
    prev.setSuccessful(false)
}</stringProp>
